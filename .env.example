# Copy to .env and fill in real values. Never commit .env itself.
FACEGUARD_FLASK_SECRET=change-this-to-a-long-random-string

FACEGUARD_ALERTS_ENABLED=true
FACEGUARD_EMAIL_ENABLED=false
FACEGUARD_SMTP_HOST=smtp.gmail.com
FACEGUARD_SMTP_PORT=587
FACEGUARD_SMTP_USERNAME=
FACEGUARD_SMTP_PASSWORD=
FACEGUARD_ALERT_RECIPIENTS=security1@example.com,security2@example.com

FACEGUARD_RETENTION_DAYS=30

# Your institution's coordinates (map centre)
FACEGUARD_CAMPUS_LAT=-28.7382
FACEGUARD_CAMPUS_LNG=24.7633

# Street-level heat map tuning (metres)
FACEGUARD_HEAT_BANDWIDTH_M=120
FACEGUARD_STREET_RADIUS_M=150
